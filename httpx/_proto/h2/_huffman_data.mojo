comptime HUFFMAN_EOS = 256

comptime HUFFMAN_CODE_WIDTH = 10

comptime HUFFMAN_STATE_COUNT = 256

comptime HUFFMAN_STATE_WIDTH = 6

comptime HUFFMAN_ACCEPTED = 1
"""A string may legally end in this state, so what follows is padding."""

comptime HUFFMAN_SYMBOL = 2
"""A symbol came out on the way here, and this record holds it."""

comptime HUFFMAN_FAIL = 4
"""These bits walked into EOS, which no valid encoding contains."""

