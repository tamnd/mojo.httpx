            "",
        )
    )
    out.append(
        UrlCase(
            "https://­/",
            "",
            True,
            "",
            "",
        )
    )
    out.append(
        UrlCase(
            "https://%C2%AD/",
            "",
            True,
            "",
            "",
        )
    )
    out.append(
        UrlCase(
            "https://xn--/",
            "",
            False,
            "https://xn--/",
            (
                "a label that starts with xn-- has to decode to something"
                " UTS-46 would have produced, and this one does not, so it is"
                " rejected rather than passed through. WHATWG keeps the label"
                " as written when the decode is not usable, which sends a name"
                " to DNS that no conforming encoder would have written."
            ),
        )
    )
    out.append(
        UrlCase(
            "///test",
            "http://example.org/",
            False,
            "http://test/",
            (
                "an http url has to name a host, so this is rejected. WHATWG"
                " keeps reading past the empty authority and takes the first"
                " non empty path segment as the host instead."
            ),
        )
    )
    out.append(
        UrlCase(
            "///\\//\\//test",
            "http://example.org/",
            False,
            "http://test/",
            (
                "an http url has to name a host, so this is rejected. WHATWG"
                " keeps reading past the empty authority and takes the first"
                " non empty path segment as the host instead."
            ),
        )
    )
    out.append(
        UrlCase(
            "///example.org/path",
            "http://example.org/",
            False,
            "http://example.org/path",
            (
                "an http url has to name a host, so this is rejected. WHATWG"
                " keeps reading past the empty authority and takes the first"
                " non empty path segment as the host instead."
            ),
        )
    )
    out.append(
        UrlCase(
            "///example.org/../path",
            "http://example.org/",
            False,
            "http://example.org/path",
            (
                "an http url has to name a host, so this is rejected. WHATWG"
                " keeps reading past the empty authority and takes the first"
                " non empty path segment as the host instead."
            ),
        )
    )
    out.append(
        UrlCase(
            "///example.org/../../",
            "http://example.org/",
            False,
            "http://example.org/",
            (
                "an http url has to name a host, so this is rejected. WHATWG"
                " keeps reading past the empty authority and takes the first"
                " non empty path segment as the host instead."
            ),
        )
    )
    out.append(
        UrlCase(
            "///example.org/../path/../../",
            "http://example.org/",
            False,
            "http://example.org/",
            (
                "an http url has to name a host, so this is rejected. WHATWG"
                " keeps reading past the empty authority and takes the first"
                " non empty path segment as the host instead."
            ),
        )
    )
    out.append(
        UrlCase(
            "///example.org/../path/../../path",
            "http://example.org/",
            False,
            "http://example.org/path",
            (
                "an http url has to name a host, so this is rejected. WHATWG"
                " keeps reading past the empty authority and takes the first"
                " non empty path segment as the host instead."
            ),
        )
    )
    out.append(
        UrlCase(
            "/\\/\\//example.org/../path",
            "http://example.org/",
            False,
            "http://example.org/path",
            (
                "a backslash is an ordinary path character here and is encoded"
                " as %5C. WHATWG reads it as a path separator for http and"
                " https."
            ),
        )
    )
    return out^
